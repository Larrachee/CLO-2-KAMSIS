<?php
include "config.php";

$pesan = "";

if (isset($_POST['submit_login'])) {
    $user = $_POST['user'];
    $pass = $_POST['pass'];


    if (strlen($user) > 20) {
        $pesan = "INPUT TERLALU PANJANG! MAKS 20";
    } else {
        

        $query = $pdo->prepare("SELECT * FROM users WHERE username = ?");
        $query->execute([$user]);
        $data = $query->fetch();

        if ($data && password_verify($pass, $data['password_hash'])) {
            $pesan = "LOGIN BERHASIL! Selamat datang " . htmlspecialchars($data['username']);
        } else {
            $pesan = "LOGIN GAGAL! Username/Password salah.";
        }
    }
}
