<?php
include "config.php";
session_start(); // Penting agar sistem tahu kita sudah login

$pesan = "Silakan Login";

// Logika Logout (untuk balik ke halaman login)
if (isset($_GET['logout'])) {
    session_destroy();
    header("Location: index.php");
    exit();
}

if ($_SERVER["REQUEST_METHOD"] == "POST") {
    
    // JIKA USER KLIK TOMBOL MASUK
    if (isset($_POST['tombol_login'])) {
        $user = $_POST['user'];
        $pass = $_POST['pass'];

        if (strlen($user) > 20) {
            $pesan = "<b style='color:red;'>SECURITY ERROR: Input Buffer Overflow!</b>";
        } else {
            // 2. CEK SQL INJECTION (Poin 10)
            // Pakai prepare agar aman dari ' OR 1=1
            $stmt = $pdo->prepare("SELECT * FROM users WHERE username = ? AND password_hash = ?");
            $stmt->execute([$user, $pass]);
            $data = $stmt->fetch();

            if ($data) {
                $_SESSION['nama_user'] = $data['username'];
                $pesan = "<b style='color:green;'>Login Berhasil! Selamat Datang.</b>";
            } else {
                $pesan = "<b style='color:orange;'>Login Gagal: User/Pass Salah atau SQLi Diblokir!</b>";
            }
        }
    }

    // JIKA USER KLIK TOMBOL KIRIM KOMENTAR
    if (isset($_POST['kirim_komentar'])) {
        // Pencegahan XSS (Bonus Poin Keamanan)
        $komen = htmlspecialchars($_POST['isi_komentar']);
        $pesan = "Komentar Terkirim: " . $komen;
    }
}
?>

<html>
