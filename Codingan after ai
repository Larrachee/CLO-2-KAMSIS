<?php
// Memasukkan koneksi database
include 'config.php';

// --- IMPLEMENTASI DEFENSE IN DEPTH: LAYER APLIKASI ---

$status_message = "";

if ($_SERVER["REQUEST_METHOD"] == "POST") {
    
    // Menjalankan strlen() untuk membatasi input agar tidak mengeksploitasi peladen
    $user_input = $_POST['username'];
    $pass_input = $_POST['password'];

    if (strlen($user_input) > 20) {
        $status_message = "<div style='color:red;'>[Kritis] Eksploitasi Buffer Overflow Terdeteksi: Input melebihi batas 20 karakter!</div>";
    } else {
        
        // Menggunakan Prepared Statements untuk mengunci akses basis data
        try {
            $stmt = $pdo->prepare("SELECT * FROM users WHERE username = ?");
            $stmt->execute([$user_input]);
            $user = $stmt->fetch();

            // Memverifikasi Hash Bcrypt yang tersimpan di MySQL
            if ($user && password_verify($pass_input, $user['password_hash'])) {
                $status_message = "<div style='color:green;'>[Berhasil] Autentikasi Valid. Jalur Komunikasi Terenkripsi (SSL/TLS).</div>";
            } else {
                $status_message = "<div style='color:red;'>[Gagal] Kredensial tidak valid atau serangan SQL Injection diblokir.</div>";
            }
        } catch (PDOException $e) {
            $status_message = "Terjadi kesalahan sistem.";
        }
    }
}
?>

