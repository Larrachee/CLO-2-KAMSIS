        Status: <?php echo $pesan; ?>
    </div>

    <?php if (!isset($_SESSION['nama_user'])): ?>
        <form method="POST">
            <h3>Halaman Login</h3>
            Username: <input type="text" name="user"><br><br>
            Password: <input type="password" name="pass"><br><br>
            <input type="submit" name="tombol_login" value="Masuk">
        </form>
    <?php else: ?>
        <div style="background: #e2f0d9; padding: 20px; border: 1px solid #70ad47;">
            <h3>Selamat Datang, <?php echo $_SESSION['nama_user']; ?>!</h3>
            <p>Anda telah masuk ke area aman HTTPS.</p>
            
            <form method="POST">
                <b>Tulis Komentar Anda:</b><br>
                <textarea name="isi_komentar" rows="4" cols="50"></textarea><br><br>
                <input type="submit" name="kirim_komentar" value="Kirim Komentar">
            </form>
            
            <br>
            <a href="?logout=1">Logout / Keluar</a>
        </div>
    <?php endif; ?>

